<Project Sdk="Microsoft.NET.Sdk">

  <!-- 引擎测试。FsCheck 属性测试为主力，xunit 为 runner。
       断言只针对外部行为（输入 → 输出），不测内部分解结构。 -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- 座位固件。排在最前是因为几乎每个测试都写 `seat 2`；不许往后挪。 -->
  <ItemGroup>
    <Compile Include="SeatFixtures.fs" />
  </ItemGroup>

  <!-- 牌与手牌形态 -->
  <ItemGroup>
    <Compile Include="TileGenerators.fs" />
    <Compile Include="TileNotationTests.fs" />
    <Compile Include="TileProperties.fs" />
    <Compile Include="TileJsonTests.fs" />
    <Compile Include="HandShapeGenerators.fs" />
    <Compile Include="HandShapeTests.fs" />
    <Compile Include="ShantenTests.fs" />
    <Compile Include="ShantenProperties.fs" />
    <Compile Include="AgariShapeTests.fs" />
    <Compile Include="UkeireTests.fs" />
  </ItemGroup>

  <!-- 和了形、役与符点 -->
  <ItemGroup>
    <Compile Include="YakuGenerators.fs" />
    <Compile Include="NakiTests.fs" />
    <Compile Include="AgariHandTests.fs" />
    <Compile Include="DoraTests.fs" />
    <Compile Include="YakuTests.fs" />
    <Compile Include="YakuProperties.fs" />
    <Compile Include="FuTests.fs" />
    <Compile Include="FuProperties.fs" />
    <Compile Include="ScoreGenerators.fs" />
    <Compile Include="ScoreTests.fs" />
  </ItemGroup>

  <!-- 离线 oracle 对拍（固件在 fixtures/，刷新用 scripts/oracle/） -->
  <ItemGroup>
    <Compile Include="ShantenOracleTests.fs" />
  </ItemGroup>

  <!-- 规则集、座位、随机源与牌山 -->
  <ItemGroup>
    <Compile Include="KazeTests.fs" />
    <Compile Include="RulesetTests.fs" />
    <Compile Include="SeatTests.fs" />
    <Compile Include="RngTests.fs" />
    <Compile Include="RngProperties.fs" />
    <Compile Include="RulesetGenerators.fs" />
    <Compile Include="WallTests.fs" />
    <Compile Include="WallProperties.fs" />
  </ItemGroup>

  <!-- 事件与开局 -->
  <ItemGroup>
    <Compile Include="EventGenerators.fs" />
    <Compile Include="EventTests.fs" />
    <Compile Include="EventProperties.fs" />
    <Compile Include="KyokuStartGenerators.fs" />
    <Compile Include="KyokuStartTests.fs" />
    <Compile Include="KyokuStartProperties.fs" />
  </ItemGroup>

  <!-- 一局的状态机与各动作。此段顺序有依赖：后面的文件用到前面定义的生成器。 -->
  <ItemGroup>
    <Compile Include="GameStateGenerators.fs" />
    <Compile Include="GameStateTests.fs" />
    <Compile Include="GameStateProperties.fs" />
    <Compile Include="HoraTests.fs" />
    <Compile Include="PonChiTests.fs" />
    <Compile Include="KanTests.fs" />
    <Compile Include="KanProperties.fs" />
    <Compile Include="RiichiTests.fs" />
    <Compile Include="RiichiProperties.fs" />
    <Compile Include="RyuukyokuTests.fs" />
    <Compile Include="RyuukyokuProperties.fs" />
    <Compile Include="ScoreProperties.fs" />
    <Compile Include="KyokuTests.fs" />
  </ItemGroup>

  <!-- 决策包与观测投影（票 20）。局面取自 GameStateGenerators 的可达局面。 -->
  <ItemGroup>
    <Compile Include="ObservationTests.fs" />
    <Compile Include="ObservationProperties.fs" />
    <Compile Include="DecisionPackageTests.fs" />
    <Compile Include="DecisionPackageProperties.fs" />
  </ItemGroup>

  <!-- 整场对局 -->
  <ItemGroup>
    <Compile Include="GameGenerators.fs" />
    <Compile Include="GameTests.fs" />
    <Compile Include="GameProperties.fs" />
  </ItemGroup>

  <!-- M0 验收跑批（票 14）：一批种子跑到底，逐手验不变量、逐场数覆盖率。 -->
  <ItemGroup>
    <Compile Include="SoakTests.fs" />
  </ItemGroup>

  <!-- 双目标黄金用例（票 21）：dotnet 侧跑的那一遍。JS 侧跑同一份数据，
       入口在 web/scripts/verify-golden.mjs。 -->
  <ItemGroup>
    <Compile Include="GoldenSuiteTests.fs" />
  </ItemGroup>

  <!-- 真实牌谱对拍（票 13）。顺序有依赖：事件 → oracle → 重放 → 对拍 → 断言。 -->
  <ItemGroup>
    <Compile Include="PaifuEvent.fs" />
    <Compile Include="PaifuOracle.fs" />
    <Compile Include="PaifuReplay.fs" />
    <Compile Include="PaifuDifferential.fs" />
    <Compile Include="PaifuDifferentialTests.fs" />
  </ItemGroup>

  <!-- oracle 对拍固件：由 scripts/oracle/refresh-fixture.sh 生成，让 dotnet test 能离线对拍。 -->
  <ItemGroup>
    <Content Include="fixtures/shanten-oracle.tsv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 真实牌谱固件（tests/fixtures/paifu/，来源与许可见同目录 README）：
       mjai 事件流驱动重放，天凤官方 JSON 作役 / 符 / 点数的 oracle。
       `Link` 把它们落到输出目录的 fixtures/paifu/ 下，因此 dotnet test 离线跑。 -->
  <ItemGroup>
    <Content Include="../fixtures/paifu/mjai/*.mjson" Link="fixtures/paifu/mjai/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../fixtures/paifu/tenhou/*.json" Link="fixtures/paifu/tenhou/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 黄金用例固件（票 21）：用例本身是数据，**不写死在任一侧的代码里**。
       刷新用 `janpo golden write tests/fixtures/golden/dual-target.json`。 -->
  <ItemGroup>
    <Content Include="../fixtures/golden/*.json" Link="fixtures/golden/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Janpo.Engine/Janpo.Engine.fsproj" />
    <ProjectReference Include="../../src/Janpo.Golden/Janpo.Golden.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FsCheck" />
    <PackageReference Include="FsCheck.Xunit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Thoth.Json.Newtonsoft" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
