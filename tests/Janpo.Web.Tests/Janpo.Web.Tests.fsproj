<Project Sdk="Microsoft.NET.Sdk">

  <!-- 牌桌的 UI 逻辑测试（票 22）。**只测不碰 React 的那三层**：播放控制的状态机、
       牌桌的推进、投影选择与结算。纯渲染（Feliz 的 DSL）不在这里测——那要一个浏览器，
       而浏览器侧的验收在 web/ 那边（无头跑真页面）。

       Janpo.Web 是 Fable 工程，它的 .NET 产物只当类型检查用；但这三个文件一行 Feliz 都不 open，
       因此在 dotnet 上跑得起来。加测试时守住这条：**要 open Feliz 就说明那段逻辑放错文件了**。 -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="PlaybackTests.fs" />
    <Compile Include="TableTests.fs" />
    <Compile Include="BoardTests.fs" />
    <!-- 一份牌谱摆成逐帧的牌桌（票 71）：首页 Demo 回放的地基。 -->
    <Compile Include="ReplayTableTests.fs" />
    <!-- 回放的时间轴（票 75）：游标动得对不对（拖、步进、跳局、两头与幂等）。 -->
    <Compile Include="ReplayTimelineTests.fs" />
    <!-- 思考气泡（票 76）：三态、按座位取的取值器、全文面板与那一手的局面快照。 -->
    <Compile Include="ThinkingBubbleTests.fs" />
    <Compile Include="AgentTests.fs" />
    <!-- 模型档案库 + 四席绑定（票 73）：两个维度的分工、删档案的善后、老配置的迁移。 -->
    <Compile Include="SeatingPlanTests.fs" />
    <Compile Include="TablePageTests.fs" />
    <!-- 真人坐席（票 87）：第四种选手、合法性驱动的出牌、自动过与可见性三锁。 -->
    <Compile Include="HumanSeatTests.fs" />
    <Compile Include="HumanCallTests.fs" />
    <!-- 真人的信息辅助与思考时限（票 89）：Bare 什么都不给、Assisted 与模型拿到的是同一份数、
         倒计时只在轮到自己时走、到点代他打一手而牌局继续。 -->
    <Compile Include="HumanAssistTests.fs" />
    <!-- 强 AI 基线坐一席（票 92）：第四种选手、懒加载、降级真打完一场、它不会说话。 -->
    <Compile Include="BaselineSeatTests.fs" />
    <!-- 它的来历摆在人看得见的地方（票 102）：配桌页那一句、加载与降级那两句里的署名。 -->
    <Compile Include="BaselineCreditTests.fs" />
    <!-- 复盘：逐手对照标注（票 90）。只在终局后、每一手都有一条、每一个数都是引擎算的。 -->
    <Compile Include="ReviewTests.fs" />
    <!-- 配桌上那三项规则开关（票 72）：拨得动、按重开才生效、牌谱里的 `ruleset` 跟着变。 -->
    <Compile Include="TableSetupTests.fs" />
    <!-- 首页那一屏（票 71）：那份资产够不够格当门面，以及拉 / 播 / 停 / 再放那个状态机。 -->
    <Compile Include="HomePageTests.fs" />
    <!-- 牌谱从外面进来的两条路（票 78）：分享链接的载荷与导入的 JSON，三种失法与阈值。 -->
    <Compile Include="ImportShareTests.fs" />
    <Compile Include="PaifuExportTests.fs" />
  </ItemGroup>

  <!-- 首页那份 Demo Paifu（ADR-0003 的**产品资产**，不是测试固件）。拷进输出目录是为了
       `HomePageTests` 能对它验收：票 79 换成真的四席对局时，不合格当场红。
       产出它的命令写在 CLI 的 usage 里（`janpo paifu`）与报告 71 里。 -->
  <ItemGroup>
    <Content Include="../../web/public/demo-paifu.json" Link="demo-paifu.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Janpo.Web/Janpo.Web.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- 决策包与回执的 codec 写在 Thoth.Json.Core 上（后端无关）：浏览器里由
         Thoth.Json.JavaScript 跑，这里由 Newtonsoft 跑，**同一份 decoder 两个后端**。 -->
    <PackageReference Include="Thoth.Json.Newtonsoft" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
