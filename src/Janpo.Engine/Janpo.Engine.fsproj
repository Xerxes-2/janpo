<Project Sdk="Microsoft.NET.Sdk">

  <!-- 规则引擎。M1 要经 Fable 编译进浏览器，因此**只允许** Fable 兼容的
       F# 子集与核心库：不用反射、不用 System.Text.Json、不用 printf 以外的
       格式化技巧、不引入任何 dotnet-only 的 NuGet 包。JSON 一律走 Thoth.Json.Core。 -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- 牌与手牌形态。加新的形态判定放这里（例：向听的变体、听牌型分类）。 -->
  <ItemGroup>
    <Compile Include="Tile.fs" />
    <Compile Include="TileKindSet.fs" />
    <Compile Include="HandShape.fs" />
    <Compile Include="Shanten.fs" />
    <Compile Include="AgariShape.fs" />
    <Compile Include="Ukeire.fs" />
  </ItemGroup>

  <!-- 规则集、对局长度与座位。**新增规则开关改 Ruleset.fs**，别在别处开全局开关。 -->
  <ItemGroup>
    <Compile Include="Kaze.fs" />
    <Compile Include="GameLength.fs" />
    <Compile Include="Ruleset.fs" />
    <Compile Include="Seat.fs" />
  </ItemGroup>

  <!-- 和了形、役与点数。纯函数区：输入牌姿与上下文，输出役/符/点数，不碰状态机。 -->
  <ItemGroup>
    <Compile Include="Mentsu.fs" />
    <Compile Include="Naki.fs" />
    <Compile Include="AgariHand.fs" />
    <Compile Include="MentsuBreakdown.fs" />
    <Compile Include="Dora.fs" />
    <Compile Include="Yaku.fs" />
    <Compile Include="Fu.fs" />
    <Compile Include="Score.fs" />
  </ItemGroup>

  <!-- 牌山与随机源。种子化洗牌的一切都在这两个文件里。 -->
  <ItemGroup>
    <Compile Include="Rng.fs" />
    <Compile Include="Wall.fs" />
  </ItemGroup>

  <!-- 逐座位的持续状态（跨巡存在的标志）。振听、立直、一发这类。 -->
  <ItemGroup>
    <Compile Include="Furiten.fs" />
    <Compile Include="RiichiState.fs" />
  </ItemGroup>

  <!-- 事件与开局。**加 Event case 要同时改 DU / encoder / decoder 三处**（备注 N-1）。 -->
  <ItemGroup>
    <Compile Include="Event.fs" />
    <Compile Include="KyokuStart.fs" />
  </ItemGroup>

  <!-- 一局之内的状态机。加动作要改 Action 的 case、产出动作集的函数、step 的执行 match 三处。 -->
  <ItemGroup>
    <Compile Include="Action.fs" />
    <Compile Include="PlayerState.fs" />
    <Compile Include="Ryuukyoku.fs" />
    <Compile Include="GameState.fs" />
    <Compile Include="Kyoku.fs" />
  </ItemGroup>

  <!-- 决策包（M1 的 F#/TS 接缝）：局面 → 某座位的合法观测 + 编号动作集。
       `GameState` 永不越界，跨界的只有决策包 JSON（单向）与一个动作 id。 -->
  <ItemGroup>
    <Compile Include="ScaffoldTier.fs" />
    <Compile Include="Observation.fs" />
    <Compile Include="DecisionPackage.fs" />
    <Compile Include="Fallback.fs" />
  </ItemGroup>

  <!-- 选手（CONTEXT.md 的 Player）：引擎自带的 bot。LLM 适配器与真人坐席是 Agent 层的事。 -->
  <ItemGroup>
    <Compile Include="RandomPlayer.fs" />
  </ItemGroup>

  <!-- 整场对局（GameState 之上一层）：局间推进、连庄、终局精算。 -->
  <ItemGroup>
    <Compile Include="Game.fs" />
  </ItemGroup>

  <!-- 跑批（M0 验收）：一批种子跑到底，逐手验不变量、逐场数覆盖率。CLI 与 CI 共用它。 -->
  <ItemGroup>
    <Compile Include="Soak.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Thoth.Json.Core" />
  </ItemGroup>

  <!-- 黄金用例要「让指定的和了在指定 Junme 发生」，为此引擎给测试留了两个 internal 的
       构造入口（`Wall.ofOrdered` / `GameState.startFrom`）。生产 API 不受影响。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="Janpo.Engine.Tests" />
  </ItemGroup>

</Project>
