<Project Sdk="Microsoft.NET.Sdk">

  <!-- 浏览器侧的宿主工程（Fable → JS）。**引擎源码一行不改地被两个目标共用**：
       dotnet 侧由 Janpo.Cli / 测试工程引用，Fable 侧由这里引用。
       Fable 运行时后端（Thoth.Json.JavaScript）与 React 封装（Feliz）只准出现在这里，
       不得进 Janpo.Engine.fsproj —— scripts/ci.sh 的依赖白名单守着这条。

       构建：`dotnet fable src/Janpo.Web -o web/src/generated`（web/package.json 已包好）。
       它不产出 .NET 运行时资产，`dotnet build` 只当类型检查用。 -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- 引擎调用与 MVU。加页面放这里。
       `Agent.fs` 是 F#/TS 的那道边界（票 23）：它 `import` 的 `web/src/agent/decide.ts`
       是**整个工程里 F# 唯一调 TS 的地方**（ADR-0005）。
       `Golden.fs` 不在页面里，它是无头闸门（票 21）在浏览器里 `import` 的那个入口；
       `PaifuCheck.fs` 同理（票 26：下下来的牌谱回放得回去吗）。 -->
  <ItemGroup>
    <Compile Include="Agent.fs" />
    <Compile Include="Roster.fs" />
    <!-- 模型档案库与四席绑定（票 73）：排在 `Roster.fs` 后面（要 `Bot` / `SeatPlayer`）、
         `Store.fs` 前面（它落 localStorage）。 -->
    <Compile Include="SeatingPlan.fs" />
    <!-- 配桌上拨得动的那三项规则（票 72）：排在 `Store.fs` 前面——它们落 localStorage。 -->
    <Compile Include="RulesetDraft.fs" />
    <Compile Include="Store.fs" />
    <Compile Include="Download.fs" />
    <!-- 地址栏读出来的那点东西（票 71）：页面侧认地址的地方只有它。 -->
    <Compile Include="Route.fs" />
    <Compile Include="Playback.fs" />
    <Compile Include="Table.fs" />
    <Compile Include="Board.fs" />
    <Compile Include="Tracer.fs" />
    <Compile Include="Golden.fs" />
    <Compile Include="PaifuCheck.fs" />
    <Compile Include="Share.fs" />
    <!-- 首页那份 Demo Paifu（票 71）：F# 调 TS 的第三处（ADR-0005），只传字符串。 -->
    <Compile Include="Demo.fs" />
    <Compile Include="App.fs" />
    <!-- 牌桌页（票 70 把 1647 行的 `TablePage.fs` 拆成五个）。**这五行的先后就是编译顺序**，
         F# 只往前看，所以按依赖排：状态与 MVU（`TableState`）→ Agent 层那两行状态（`AgentLine`）
         → 牌桌与结算的视图（`TableBoard`，它把上一行接在最前面）→ 配桌与模型面板（`TablePanel`）
         → 把四块装回一屏的外壳（`TablePage`，`Main.fs` 与 dotnet 侧用例认的仍是这个名字）。
         拆的判据是「哪张票会改它」：改状态与消息的进 `TableState`，改面板的进 `TablePanel`，
         改牌桌与结算的进 `TableBoard`。 -->
    <Compile Include="TableState.fs" />
    <Compile Include="AgentLine.fs" />
    <Compile Include="TableBoard.fs" />
    <Compile Include="TablePanel.fs" />
    <Compile Include="TablePage.fs" />
    <!-- 页脚（票 37）：仓库与许可地址的唯一真源，只被 `Main.fs` 的页面外壳用。 -->
    <Compile Include="Footer.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Janpo.Engine/Janpo.Engine.fsproj" />
    <!-- 黄金用例（票 21）：跑与对照的那段代码两个目标共用，这里只接 JS 侧的 JSON 后端。 -->
    <ProjectReference Include="../Janpo.Golden/Janpo.Golden.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" />
    <PackageReference Include="Fable.Elmish" />
    <PackageReference Include="Feliz" />
    <PackageReference Include="Feliz.UseElmish" />
    <!-- Thoth.Json.Core 只是抽象层，JS 侧需要一个具体后端（dotnet 侧的对应物是 Newtonsoft）。 -->
    <PackageReference Include="Thoth.Json.JavaScript" />
  </ItemGroup>

</Project>
